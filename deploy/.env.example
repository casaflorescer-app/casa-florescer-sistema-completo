# Copie para deploy/.env na VPS. Nunca commite deploy/.env.
# Gere os segredos com: node deploy/generate-keys.mjs
# Os valores CHANGE_ME são substituídos por esse comando.
# Domínio, e-mail do certificado e SMTP você preenche à mão.

APP_HOST=sistema.thvp.cloud
API_HOST=api.thvp.cloud
ACME_EMAIL=thiago_98videira@hotmail.com

POSTGRES_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ANON_KEY=CHANGE_ME
SERVICE_ROLE_KEY=CHANGE_ME
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

DASHBOARD_USERNAME=casa
DASHBOARD_PASSWORD=CHANGE_ME
SECRET_KEY_BASE=CHANGE_ME
REALTIME_DB_ENC_KEY=CHANGE_ME
VAULT_ENC_KEY=CHANGE_ME
PG_META_CRYPTO_KEY=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_ID=CHANGE_ME
S3_PROTOCOL_ACCESS_KEY_SECRET=CHANGE_ME
LOGFLARE_PUBLIC_ACCESS_TOKEN=CHANGE_ME
LOGFLARE_PRIVATE_ACCESS_TOKEN=CHANGE_ME

SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
SITE_URL=
