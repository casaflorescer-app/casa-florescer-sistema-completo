NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth/SSR (padrão). STATIC_EXPORT=true só para build estático legado.
STATIC_EXPORT=false
# NEXT_PUBLIC_BASE_PATH=

# Opcional no servidor apenas — NUNCA no frontend nem no PWA:
# SUPABASE_SECRET_KEY=
# (no arquivo .env real; este .env.example nao recebe a chave)

# Transcrição automática (servidor). Desabilitada por padrão nesta etapa.
# O fluxo clínico funciona sem chave: status UNAVAILABLE (não é falha).
# TRANSCRIPTION_AI_ENABLED=false
# OPENAI_API_KEY=
# Somente desenvolvimento local (nunca produção):
# TRANSCRIPTION_DEV_MOCK=true

# SMTP (Gmail) NÃO vai para a Vercel. Rode scripts/setup-gmail-smtp.ps1
# ou Project Settings → Authentication → SMTP Settings.
