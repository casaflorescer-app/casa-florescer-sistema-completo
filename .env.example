# Copie para .env.local — nunca commite .env.local.
# Produção na VPS: use deploy/.env.example (não este arquivo) e docs/Infraestrutura.md.
# No Vercel: Project → Settings → Environment Variables
# (Production + Preview + Development).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Auth/SSR (padrão). STATIC_EXPORT=true só para build estático legado.
STATIC_EXPORT=false
# NEXT_PUBLIC_BASE_PATH=

# Opcional no servidor apenas — NUNCA no frontend nem no PWA:
# SUPABASE_SECRET_KEY=
# (no arquivo .env real; este .env.example nao recebe a chave)

# Transcrição automática (servidor). Desabilitada por padrão nesta etapa.
# O fluxo clínico funciona sem chave: status UNAVAILABLE (não é falha).
# TRANSCRIPTION_AI_ENABLED=false
# OPENAI_API_KEY=
# Somente desenvolvimento local (nunca produção):
# TRANSCRIPTION_DEV_MOCK=true

# Central de Relacionamentos — providers de envio (servidor). Desligados por padrão.
# Sem essas flags o sistema PREPARA campanhas, mas NÃO envia (StubProvider = SIMULAÇÃO).
# WHATSAPP_PROVIDER_ENABLED=false
# WHATSAPP_API_KEY=
# EMAIL_PROVIDER_ENABLED=false
# EMAIL_API_KEY=
# WEB_PUSH_ENABLED=false
# WEB_PUSH_PUBLIC_KEY=
# WEB_PUSH_PRIVATE_KEY=

# C070-C8 — atalhos externos (apenas URLs públicas; sem tokens/senhas).
# NEXT_PUBLIC_CHATWOOT_URL=https://cap-romao-chatwoot.cr49ek.easypanel.host?utm_source=chatgpt.com
# NEXT_PUBLIC_EVOLUTION_MANAGER_URL=https://cap-romao-evolution-api.cr49ek.easypanel.host/manager?utm_source=chatgpt.com

# SMTP (Gmail) NÃO vai para a Vercel. Rode scripts/setup-gmail-smtp.ps1
# ou Project Settings → Authentication → SMTP Settings.

# Casa no Postgres próprio. Não preencher na produção enquanto o login for o Auth.
# A URL de desenvolvimento fica fora deste arquivo. Não colar senha aqui.
# CASA_DATABASE_URL=
# CASA_SESSION_SECRET=
# NEXT_PUBLIC_CASA_AUTH=
# CASA_SMTP_HOST=
