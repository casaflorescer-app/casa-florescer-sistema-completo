# Copie para .env.local — nunca commite .env.local.
# No Vercel: Project → Settings → Environment Variables
# (Production + Preview + Development).

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole_aqui_a_chave_anon_public
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Hospedagem estática provisória (GitHub Pages).
# No retorno ao Vercel/EasyPanel: STATIC_EXPORT=false (ou altere next.config.mjs)
STATIC_EXPORT=true
NEXT_PUBLIC_BASE_PATH=/casa-florescer-sistema-completo

# Opcional no servidor apenas — NUNCA no frontend nem no PWA:
# SUPABASE_SECRET_KEY=
# (no arquivo .env real; este .env.example nao recebe a chave)

# SMTP (Gmail) NÃO vai para a Vercel. Rode scripts/setup-gmail-smtp.ps1
# ou Project Settings → Authentication → SMTP Settings.
